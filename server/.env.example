# Server Port & Environment
PORT=5005
NODE_ENV=production

# Database (MongoDB Atlas URI)
# In MongoDB Atlas: Network Access -> Add IP Address -> Allow Access from Anywhere (0.0.0.0/0)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/sih_portal?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_string_for_jwt_tokens

# Email Notification via SendGrid (Optional)
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=codersclub@gprec.ac.in
SENDGRID_FROM_NAME=Coders Club & CIE SIH Portal

# WhatsApp Group Invite for Registered Team Leaders
WHATSAPP_GROUP_LINK=https://chat.whatsapp.com/your_group_link_here

# Administrator Credentials
ADMIN_EMAIL=admin@codersclub.edu.in
ADMIN_PASSWORD=your_primary_admin_password
ADMIN_EMAIL_2=asmaeram006@gmail.com
ADMIN_PASSWORD_2=your_secondary_admin_password

# Contact & Official Links
CONTACT_EMAIL=codersclub@gprec.ac.in
CONTACT_PHONE=+91 74164 20488 / +91 81064 71349
PPT_TEMPLATE_URL=https://docs.google.com/presentation/d/1Bv5uDwTC8kJJMgljx0dtSGhXE69v6j30/edit?usp=sharing
LIVE_SPREADSHEET_URL=https://docs.google.com/spreadsheets/d/1vdoZzJwKesxhg62k0j876eg0H-kUSDJKd-biVDo2dZ8/edit?usp=sharing
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/your_google_apps_script_id/exec
